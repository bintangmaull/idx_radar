{
  "manifest_version": 3,
  "name": "Ajaib Scalping Recommender",
  "version": "1.0",
  "description": "Ekstensi untuk memberikan rekomendasi sinyal scalping di Multi Orderbook Ajaib.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://trade.ajaib.co.id/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
